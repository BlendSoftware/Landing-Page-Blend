# Public URL of the production site (used for canonical URLs, sitemap,
# Open Graph and structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://blendsoftware.tech

# Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender in Resend dashboard (required in production)
RESEND_FROM_EMAIL=no-reply@tudominio.com

# Destination inbox for contact form submissions
CONTACT_TO_EMAIL=contacto@blendsoftware.tech
